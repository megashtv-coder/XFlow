# Anthropic (Claude) — used server-side only by api/ai-query.js for the AI
# Q&A chat feature. Get a key at console.anthropic.com. Set this in Vercel
# Project Settings → Environment Variables (production) and/or in a local
# .env file (git-ignored) for local testing with `vercel dev`.
ANTHROPIC_API_KEY=

# Green API (WhatsApp) — used server-side by api/send-whatsapp.js and the
# daily renewal-reminder cron (api/cron/send-renewal-reminders.js). Get these
# from green-api.com after linking your WhatsApp number to a free instance.
GREENAPI_INSTANCE_ID=
GREENAPI_TOKEN=

# Random secret you choose yourself — protects the cron endpoint from being
# triggered by anyone who finds the URL. Set the SAME value here and in
# Vercel; Vercel automatically sends it as "Authorization: Bearer <value>"
# when it calls the scheduled function.
CRON_SECRET=
