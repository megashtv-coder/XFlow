# Supabase credentials
VITE_SUPABASE_URL=https://zssasbllfjeaailfteep.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_RmkUSCdjd71U6_gYlkb7Nw_Of8u4QLx

# Anthropic (Claude) — used server-side only by api/ai-query.js for the AI
# Q&A chat feature. Get a key at console.anthropic.com. Set this in Vercel
# Project Settings → Environment Variables (production) and/or in a local
# .env file (git-ignored) for local testing with `vercel dev`.
ANTHROPIC_API_KEY=

# WhatsApp Cloud API (official, Meta) — used server-side by
# api/send-whatsapp.js and the daily renewal-reminder cron
# (api/cron/send-renewal-reminders.js). Set up at developers.facebook.com:
# create a Business app, add the WhatsApp product, link your number, and
# create a System User for a permanent access token. Also requires a
# pre-approved message template (2 params: name, expiry date) — see
# WHATSAPP_TEMPLATE_NAME.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=renewal_reminder

# Random secret you choose yourself — protects the cron endpoint from being
# triggered by anyone who finds the URL. Set the SAME value here and in
# Vercel; Vercel automatically sends it as "Authorization: Bearer <value>"
# when it calls the scheduled function.
CRON_SECRET=
